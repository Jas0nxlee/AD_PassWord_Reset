# 复制为 .env 后填写。不要提交真实凭据。

# Flask / Cookie
# 使用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成。
SECRET_KEY=
FLASK_DEBUG=false
COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=1800

# LDAP / Active Directory：只允许验证证书的 LDAPS。
LDAP_SERVER=ad.example.com
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_VERIFY_CERT=true
# 内部 CA 未加入系统信任链时填写 PEM CA 文件路径。
LDAP_CA_CERT_PATH=
LDAP_CONNECT_TIMEOUT=5
LDAP_RECEIVE_TIMEOUT=10
LDAP_BASE_DN=DC=example,DC=com
LDAP_DOMAIN=example.com
LDAP_AUTH_MODE=NTLM
# 仅用于无法立即更换旧证书的临时兼容方案；严格模式保持 false。
LDAP_COMPATIBILITY_MODE=false
LDAP_CERT_SHA256=
LDAP_USER=svc-password-reset@example.com
LDAP_PASSWORD=

# SMTP：465 使用隐式 TLS；587 设置 SMTP_USE_SSL=false 以使用 STARTTLS。
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_VERIFY_CERT=true
SMTP_CA_CERT_PATH=
SMTP_TIMEOUT=10
EMAIL_ASYNC=true
EMAIL_WORKERS=2
EMAIL_QUEUE_LIMIT=100
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=

# 桌面/单机模式仅监听本机。
# 若通过 HTTPS 反向代理对外提供服务，可改为 0.0.0.0，同时必须设置 COOKIE_SECURE=true。
SERVER_HOST=127.0.0.1
SERVER_PORT=5002
OPEN_BROWSER=true

# 本项目按要求使用进程内存储，不使用 Redis；只能运行一个应用进程。
RATELIMIT_STORAGE_URI=memory://
VERIFICATION_CODE_TTL=300
VERIFICATION_CODE_COOLDOWN=60
VERIFICATION_MAX_ATTEMPTS=5
RESET_TOKEN_TTL=600

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
MAX_CONTENT_LENGTH=16384
